<Application x:Class="SysMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#6E6E73" />
        <SolidColorBrush x:Key="AppTertiaryTextBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="AppSeparatorBrush" Color="#E5E5EA" />
        <SolidColorBrush x:Key="AppControlBrush" Color="#F0F0F3" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="CpuMetricBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="MemoryMetricBrush" Color="#AF52DE" />
        <SolidColorBrush x:Key="GpuMetricBrush" Color="#34C759" />
        <SolidColorBrush x:Key="WarningMetricBrush" Color="#FF9500" />
        <SolidColorBrush x:Key="CriticalMetricBrush" Color="#FF3B30" />
        <SolidColorBrush x:Key="CpuMetricSoftBrush" Color="#EAF3FF" />
        <SolidColorBrush x:Key="MemoryMetricSoftBrush" Color="#F5EAFB" />
        <SolidColorBrush x:Key="GpuMetricSoftBrush" Color="#EAF8EE" />
        <SolidColorBrush x:Key="DetailPinBackgroundBrush" Color="#EAF3FF" />
        <SolidColorBrush x:Key="DetailPinForegroundBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="DetailUnpinnedForegroundBrush" Color="#6E6E73" />
        <SolidColorBrush x:Key="MetricTrackBrush" Color="#E9E9ED" />
        <SolidColorBrush x:Key="BandBackgroundBrush" Color="#00000000" />
        <SolidColorBrush x:Key="BandTextBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="BandSeparatorBrush" Color="#55FFFFFF" />
        <CornerRadius x:Key="AppGroupCornerRadius">16</CornerRadius>
        <CornerRadius x:Key="BandCornerRadius">0</CornerRadius>
        <system:Double x:Key="AppShadowOpacity">0.07</system:Double>

        <Style x:Key="AppWindowStyle" TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        </Style>

        <Style x:Key="AppGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource AppGroupCornerRadius}" />
        </Style>
    </Application.Resources>
</Application>
