<Application x:Class="SysMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6F8" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#62666E" />
        <SolidColorBrush x:Key="AppTertiaryTextBrush" Color="#858A93" />
        <SolidColorBrush x:Key="AppSeparatorBrush" Color="#D9DCE2" />
        <SolidColorBrush x:Key="AppControlBrush" Color="#F0F1F4" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#0A66E8" />
        <SolidColorBrush x:Key="CpuMetricBrush" Color="#1976D2" />
        <SolidColorBrush x:Key="MemoryMetricBrush" Color="#D97706" />
        <SolidColorBrush x:Key="GpuMetricBrush" Color="#7E57C2" />
        <SolidColorBrush x:Key="WarningMetricBrush" Color="#D97706" />
        <SolidColorBrush x:Key="CriticalMetricBrush" Color="#C6262E" />
        <SolidColorBrush x:Key="CpuMetricSoftBrush" Color="#E3F0FD" />
        <SolidColorBrush x:Key="MemoryMetricSoftBrush" Color="#FFF0DC" />
        <SolidColorBrush x:Key="GpuMetricSoftBrush" Color="#EFE8FA" />
        <SolidColorBrush x:Key="DetailPinBackgroundBrush" Color="#DCEBFF" />
        <SolidColorBrush x:Key="DetailPinForegroundBrush" Color="#0A66E8" />
        <SolidColorBrush x:Key="DetailUnpinnedForegroundBrush" Color="#62666E" />
        <SolidColorBrush x:Key="MetricTrackBrush" Color="#F0F1F4" />
        <SolidColorBrush x:Key="BandBackgroundBrush" Color="#00000000" />
        <SolidColorBrush x:Key="BandTextBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="BandSeparatorBrush" Color="#55FFFFFF" />
        <CornerRadius x:Key="AppGroupCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="BandCornerRadius">0</CornerRadius>
        <system:Double x:Key="AppShadowOpacity">0.07</system:Double>

        <Style x:Key="AppWindowStyle" TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        </Style>

        <Style x:Key="AppGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource AppGroupCornerRadius}" />
        </Style>
    </Application.Resources>
</Application>
