<Application x:Class="SysMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif</FontFamily>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6F8" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#707579" />
        <SolidColorBrush x:Key="AppTertiaryTextBrush" Color="#9AA0A6" />
        <SolidColorBrush x:Key="AppSeparatorBrush" Color="#E4E7EC" />
        <SolidColorBrush x:Key="AppControlBrush" Color="#F0F1F4" />
        <SolidColorBrush x:Key="AppControlHoverBrush" Color="#E8EEF4" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#3390EC" />
        <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CpuMetricBrush" Color="#3390EC" />
        <SolidColorBrush x:Key="MemoryMetricBrush" Color="#8774E1" />
        <SolidColorBrush x:Key="GpuMetricBrush" Color="#31B545" />
        <SolidColorBrush x:Key="WarningMetricBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="CriticalMetricBrush" Color="#E53935" />
        <SolidColorBrush x:Key="CpuMetricSoftBrush" Color="#E8F4FD" />
        <SolidColorBrush x:Key="MemoryMetricSoftBrush" Color="#F2EFFE" />
        <SolidColorBrush x:Key="GpuMetricSoftBrush" Color="#EAF8EC" />
        <SolidColorBrush x:Key="DetailPinBackgroundBrush" Color="#E8F4FD" />
        <SolidColorBrush x:Key="DetailPinForegroundBrush" Color="#3390EC" />
        <SolidColorBrush x:Key="DetailUnpinnedForegroundBrush" Color="#707579" />
        <SolidColorBrush x:Key="MetricTrackBrush" Color="#F0F1F4" />
        <SolidColorBrush x:Key="BandBackgroundBrush" Color="#00000000" />
        <SolidColorBrush x:Key="BandTextBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="BandSeparatorBrush" Color="#55FFFFFF" />
        <CornerRadius x:Key="AppGroupCornerRadius">12</CornerRadius>
        <CornerRadius x:Key="ModernWindowCornerRadius">16</CornerRadius>
        <CornerRadius x:Key="ModernCardCornerRadius">12</CornerRadius>
        <CornerRadius x:Key="ModernControlCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="ModernPillCornerRadius">16</CornerRadius>
        <CornerRadius x:Key="BandCornerRadius">0</CornerRadius>
        <system:Double x:Key="AppShadowOpacity">0.14</system:Double>

        <Style x:Key="AppWindowStyle" TargetType="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="AppGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ModernCardCornerRadius}" />
        </Style>
    </Application.Resources>
</Application>
