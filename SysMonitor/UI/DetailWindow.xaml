<Window x:Class="SysMonitor.UI.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SysMonitor.UI"
        Title="SysMonitor"
        Width="480"
        Height="736"
        MinWidth="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="DetailWindow_Loaded"
        Activated="DetailWindow_Activated"
        LocationChanged="DetailWindow_LocationChanged"
        DpiChanged="DetailWindow_DpiChanged"
        Style="{DynamicResource AppWindowStyle}">
    <Window.Resources>
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource AppControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource AppSeparatorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBg" Property="Background" Value="#E81123" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBg" Property="Background" Value="#C4101E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource AppGroupStyle}">
            <Setter Property="Padding" Value="15" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="MetricProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource MetricTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2.5" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="2.5" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
    </Window.Resources>

    <!-- Outer container providing smooth 16px corner radius and soft shadow -->
    <Border Margin="14"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppSeparatorBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.18" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Window Title Bar with Left Brand/Status & Right Control Buttons -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Brand & Status -->
                <StackPanel Grid.Column="0" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextBrush}" Text="SysMonitor" />
                    <Border Margin="10,0,0,0" Padding="8,3" Background="{DynamicResource CpuMetricSoftBrush}" CornerRadius="10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,5,0" Fill="{DynamicResource GpuMetricBrush}" />
                            <TextBlock Text="实时监控" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Window Control Buttons (Pin, Minimize, Close) -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PinButton" Style="{StaticResource WindowControlButtonStyle}" Click="PinButton_Click" ToolTip="面板置顶">
                        <TextBlock x:Name="PinIcon" Text="📌" FontSize="12" Foreground="{DynamicResource AppSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeButton_Click" ToolTip="隐藏面板">
                        <TextBlock Text="─" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" ToolTip="关闭面板">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalFirst">
                <StackPanel Margin="16,4,16,16">
                    <!-- CPU Card -->
                    <Border Height="130" Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top" Background="{DynamicResource CpuMetricSoftBrush}" CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource CpuMetricBrush}" Text="CPU" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock x:Name="ProcessorLabelText" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="CpuDetailsText" Margin="0,4,8,0" FontSize="11.5"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="CpuValueText" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                            <local:HistorySparkline x:Name="CpuHistoryChart" Grid.Row="1" Metric="Cpu"
                                                    Stroke="{DynamicResource CpuMetricBrush}"
                                                    Fill="{DynamicResource CpuMetricSoftBrush}"
                                                    GridLine="{DynamicResource AppSeparatorBrush}"
                                                    SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>

                    <!-- Memory Card -->
                    <Border Height="110" Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="6" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top" Background="{DynamicResource MemoryMetricSoftBrush}" CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MemoryMetricBrush}" Text="MEM" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock x:Name="MemoryLabelText" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="MemoryDetailsText" Margin="0,4,8,0" FontSize="11.5"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="MemoryValueText" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                            <ProgressBar x:Name="MemoryProgress" Grid.Row="1" Style="{StaticResource MetricProgressStyle}" />
                        </Grid>
                    </Border>

                    <!-- GPU Card -->
                    <Border x:Name="GpuCard" Height="130" Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top" Background="{DynamicResource GpuMetricSoftBrush}" CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource GpuMetricBrush}" Text="GPU" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock x:Name="GraphicsLabelText" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="GpuNameText" Margin="0,3,8,0" FontSize="11.5"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="GpuDetailsText" Margin="0,2,8,0" FontSize="10.5"
                                               Foreground="{DynamicResource AppTertiaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="GpuValueText" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                            <local:HistorySparkline x:Name="GpuHistoryChart" Grid.Row="1" Metric="Gpu"
                                                    Stroke="{DynamicResource GpuMetricBrush}"
                                                    Fill="{DynamicResource GpuMetricSoftBrush}"
                                                    GridLine="{DynamicResource AppSeparatorBrush}"
                                                    SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>

                    <!-- Network Card (Split Download/Upload) -->
                    <Grid Height="90" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" Margin="0,0,8,0" Background="{DynamicResource CpuMetricSoftBrush}" CornerRadius="6">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource CpuMetricBrush}" Text="↓" />
                                    </Border>
                                    <TextBlock x:Name="DownloadLabelText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="DownloadValueText" Grid.Row="1" VerticalAlignment="Bottom" FontSize="20"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" Margin="0,0,8,0" Background="{DynamicResource GpuMetricSoftBrush}" CornerRadius="6">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource GpuMetricBrush}" Text="↑" />
                                    </Border>
                                    <TextBlock x:Name="UploadLabelText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="UploadValueText" Grid.Row="1" VerticalAlignment="Bottom" FontSize="20"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Storage Card -->
                    <Border x:Name="StorageCard" MinHeight="112" Style="{StaticResource CardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="StorageLabelText" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                            <Grid Grid.Row="1" MinHeight="64" Margin="0,4,0,0">
                                <TextBlock x:Name="NoDrivesText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11.5" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                <WrapPanel x:Name="DriveRowsPanel" HorizontalAlignment="Left" Orientation="Horizontal" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
