<Window x:Class="SysMonitor.UI.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SysMonitor.UI"
        Title="SysMonitor"
        Width="460"
        Height="700"
        MinWidth="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="DetailWindow_Loaded"
        Activated="DetailWindow_Activated"
        LocationChanged="DetailWindow_LocationChanged"
        DpiChanged="DetailWindow_DpiChanged"
        Style="{DynamicResource AppWindowStyle}">
    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppControlBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppSeparatorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE5E3" />
                    <Setter Property="Foreground" Value="{DynamicResource CriticalMetricBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource AppGroupStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="MetricProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource MetricTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="29" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,9,0" Fill="{DynamicResource GpuMetricBrush}" />
                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="SysMonitor" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PinButton" Style="{StaticResource TitleBarButtonStyle}" Click="PinButton_Click">
                    <Path x:Name="PinIcon" Width="15" Height="16"
                          Data="M 5,1 L 11,1 L 10,6 L 13,9 L 9,9 L 9,15 L 7,15 L 7,9 L 3,9 L 6,6 Z"
                          Fill="{DynamicResource DetailUnpinnedForegroundBrush}" Stretch="Fill" />
                </Button>
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click">
                    <Path Width="12" Height="1" Data="M 0,0.5 L 12,0.5" Stroke="{DynamicResource AppSecondaryTextBrush}"
                          StrokeThickness="1.4" Stretch="Fill" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click">
                    <Path Width="11" Height="11" Data="M 1,1 L 10,10 M 10,1 L 1,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Fill" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalFirst">
        <StackPanel Margin="16,4,16,16">
            <Border Height="128" Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" Margin="0,0,11,0" VerticalAlignment="Top" Background="{DynamicResource CpuMetricSoftBrush}" CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CpuMetricBrush}" Text="CPU" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock x:Name="ProcessorLabelText" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="CpuDetailsText" Margin="0,5,8,0" FontSize="11.5"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="CpuValueText" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource MetricValueStyle}" />
                    </Grid>
                    <local:HistorySparkline x:Name="CpuHistoryChart" Grid.Row="1" Metric="Cpu"
                                            Stroke="{DynamicResource CpuMetricBrush}"
                                            Fill="{DynamicResource CpuMetricSoftBrush}"
                                            GridLine="{DynamicResource AppSeparatorBrush}"
                                            SnapsToDevicePixels="True" />
                </Grid>
            </Border>

            <Border Height="108" Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="4" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" Margin="0,0,11,0" VerticalAlignment="Top" Background="{DynamicResource MemoryMetricSoftBrush}" CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MemoryMetricBrush}" Text="MEM" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock x:Name="MemoryLabelText" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="MemoryDetailsText" Margin="0,5,8,0" FontSize="11.5"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="MemoryValueText" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource MetricValueStyle}" />
                    </Grid>
                    <ProgressBar x:Name="MemoryProgress" Grid.Row="1" Style="{StaticResource MetricProgressStyle}" />
                </Grid>
            </Border>

            <Border x:Name="GpuCard" Height="128" Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" Margin="0,0,11,0" VerticalAlignment="Top" Background="{DynamicResource GpuMetricSoftBrush}" CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource GpuMetricBrush}" Text="GPU" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock x:Name="GraphicsLabelText" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="GpuNameText" Margin="0,3,8,0" FontSize="11.5"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="GpuDetailsText" Margin="0,2,8,0" FontSize="10.5"
                                       Foreground="{DynamicResource AppTertiaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="GpuValueText" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource MetricValueStyle}" />
                    </Grid>
                    <local:HistorySparkline x:Name="GpuHistoryChart" Grid.Row="1" Metric="Gpu"
                                            Stroke="{DynamicResource GpuMetricBrush}"
                                            Fill="{DynamicResource GpuMetricSoftBrush}"
                                            GridLine="{DynamicResource AppSeparatorBrush}"
                                            SnapsToDevicePixels="True" />
                </Grid>
            </Border>

            <Grid Height="88" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource CpuMetricBrush}" Text="↓" />
                            <TextBlock x:Name="DownloadLabelText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="DownloadValueText" Grid.Row="1" VerticalAlignment="Bottom" FontSize="20"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource GpuMetricBrush}" Text="↑" />
                            <TextBlock x:Name="UploadLabelText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="UploadValueText" Grid.Row="1" VerticalAlignment="Bottom" FontSize="20"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="StorageCard" MinHeight="112" Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="StorageLabelText" FontSize="13" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" MinHeight="64">
                        <TextBlock x:Name="NoDrivesText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11.5" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        <WrapPanel x:Name="DriveRowsPanel" Orientation="Horizontal" />
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
