<Window x:Class="SysMonitor.UI.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysMonitor"
        Width="460"
        Height="620"
        MinWidth="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="#1D1D1F">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5EA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6E6E73" />
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="TrackBrush" Color="#E9E9ED" />

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#E8E8ED" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#DCDCE1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE5E3" />
                    <Setter Property="Foreground" Value="#FF3B30" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="MetricProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="29" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="#F5F5F7"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="20,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse Width="8"
                         Height="8"
                         Margin="0,0,9,0"
                         Fill="#34C759" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="SysMonitor" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="0,0,12,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="PinButton"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="Keep on top"
                        Click="PinButton_Click">
                    <Path x:Name="PinIcon"
                          Width="15"
                          Height="16"
                          Data="M 5,1 L 11,1 L 10,6 L 13,9 L 9,9 L 9,15 L 7,15 L 7,9 L 3,9 L 6,6 Z"
                          Fill="#6E6E73"
                          Stretch="Fill" />
                </Button>
                <Button Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="Minimize"
                        Click="MinimizeButton_Click">
                    <Path Width="12"
                          Height="1"
                          Data="M 0,0.5 L 12,0.5"
                          Stroke="#6E6E73"
                          StrokeThickness="1.4"
                          Stretch="Fill" />
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}"
                        ToolTip="Close"
                        Click="CloseButton_Click">
                    <Path Width="11"
                          Height="11"
                          Data="M 1,1 L 10,10 M 10,1 L 1,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Fill" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,4,16,16">
            <Border Height="108"
                    Margin="0,0,0,10"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="4" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                Margin="0,0,11,0"
                                VerticalAlignment="Top"
                                Background="#EAF3FF"
                                CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#007AFF"
                                       Text="CPU" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Processor" />
                            <TextBlock x:Name="CpuDetailsText"
                                       Margin="0,5,8,0"
                                       FontSize="11.5"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="CpuValueText"
                                   Grid.Column="2"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource MetricValueStyle}" />
                    </Grid>
                    <ProgressBar x:Name="CpuProgress"
                                 Grid.Row="1"
                                 Style="{StaticResource MetricProgressStyle}" />
                </Grid>
            </Border>

            <Border Height="108"
                    Margin="0,0,0,10"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="4" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                Margin="0,0,11,0"
                                VerticalAlignment="Top"
                                Background="#F5EAFB"
                                CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#AF52DE"
                                       Text="MEM" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Memory" />
                            <TextBlock x:Name="MemoryDetailsText"
                                       Margin="0,5,8,0"
                                       FontSize="11.5"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="MemoryValueText"
                                   Grid.Column="2"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource MetricValueStyle}" />
                    </Grid>
                    <ProgressBar x:Name="MemoryProgress"
                                 Grid.Row="1"
                                 Style="{StaticResource MetricProgressStyle}" />
                </Grid>
            </Border>

            <Border x:Name="GpuCard"
                    Height="108"
                    Margin="0,0,0,10"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="4" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                Margin="0,0,11,0"
                                VerticalAlignment="Top"
                                Background="#EAF8EE"
                                CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#34C759"
                                       Text="GPU" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Graphics" />
                            <TextBlock x:Name="GpuNameText"
                                       Margin="0,3,8,0"
                                       FontSize="11.5"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="GpuDetailsText"
                                       Margin="0,2,8,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TertiaryTextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="GpuValueText"
                                   Grid.Column="2"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource MetricValueStyle}" />
                    </Grid>
                    <ProgressBar x:Name="GpuProgress"
                                 Grid.Row="1"
                                 Style="{StaticResource MetricProgressStyle}" />
                </Grid>
            </Border>

            <Grid Height="88" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#007AFF"
                                       Text="↓" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Download" />
                        </StackPanel>
                        <TextBlock x:Name="DownloadValueText"
                                   Grid.Row="1"
                                   VerticalAlignment="Bottom"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#34C759"
                                       Text="↑" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Upload" />
                        </StackPanel>
                        <TextBlock x:Name="UploadValueText"
                                   Grid.Row="1"
                                   VerticalAlignment="Bottom"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>

            <Border Height="54" Style="{StaticResource CardStyle}" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DriveNameText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="System disk" />
                    <ProgressBar x:Name="DriveProgress"
                                 Grid.Column="1"
                                 Height="4"
                                 Margin="15,0"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource MetricProgressStyle}" />
                    <TextBlock x:Name="DriveValueText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
