<Window x:Class="SysMonitor.UI.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SysMonitor.UI"
        Title="SysMonitor"
        Width="480"
        SizeToContent="Height"
        MinWidth="380"
        MinHeight="400"
        MaxWidth="1200"
        MaxHeight="1600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="DetailWindow_Loaded"
        Activated="DetailWindow_Activated"
        LocationChanged="DetailWindow_LocationChanged"
        DpiChanged="DetailWindow_DpiChanged"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        Style="{DynamicResource AppWindowStyle}">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,4,2,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource AppTertiaryTextBrush}" Opacity="0.45" CornerRadius="2.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource AppControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource AppSeparatorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBg" Property="Background" Value="#E53935" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBg" Property="Background" Value="#C62828" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource AppGroupStyle}">
            <Setter Property="Padding" Value="14,12,14,11" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="MetricProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource MetricTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2.5" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="2.5" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
    </Window.Resources>

    <!-- Telegram Desktop style elevated drawer container -->
    <Border x:Name="RootBorder"
            Margin="12"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppSeparatorBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.16" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Telegram Profile-Style Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="14,14,0,0"
                    BorderBrush="{DynamicResource AppSeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBar" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Circular Telegram-Blue Avatar + Stacked Name & Live Status -->
                    <StackPanel Grid.Column="0" Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#37AEE2" Offset="0" />
                                    <GradientStop Color="#1E96C8" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M 1,9 L 4.5,9 L 6.5,3 L 9.5,14 L 11.5,9 L 15,9"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}" Text="SysMonitor" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,1,5,0" Fill="{DynamicResource GpuMetricBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="实时监控" FontSize="11.5" Foreground="{DynamicResource AppAccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Circular Window Control Buttons (Pin, Hide, Close) -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton" Style="{StaticResource WindowControlButtonStyle}" Click="PinButton_Click" ToolTip="面板置顶">
                            <TextBlock x:Name="PinIcon" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="12.5" Foreground="{DynamicResource AppSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeButton_Click" ToolTip="隐藏面板">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="10.5" Foreground="{DynamicResource AppSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" ToolTip="关闭面板">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Container: Clean Telegram Sections -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="12,10,12,12">
                    <!-- 1. CPU Card -->
                    <Border Height="128" Margin="0,0,0,9" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Margin="0,0,11,0" VerticalAlignment="Center" Background="{DynamicResource CpuMetricSoftBrush}" CornerRadius="17">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource CpuMetricBrush}" Text="CPU" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProcessorLabelText" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="CpuDetailsText" Margin="0,2,4,0" FontSize="11.5"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="CpuValueText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                            <local:HistorySparkline x:Name="CpuHistoryChart" Grid.Row="1" Metric="Cpu"
                                                    Stroke="{DynamicResource CpuMetricBrush}"
                                                    Fill="{DynamicResource CpuMetricSoftBrush}"
                                                    GridLine="{DynamicResource AppSeparatorBrush}"
                                                    SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>

                    <!-- 2. Memory Card -->
                    <Border Height="90" Margin="0,0,0,9" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="5" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Margin="0,0,11,0" VerticalAlignment="Center" Background="{DynamicResource MemoryMetricSoftBrush}" CornerRadius="17">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MemoryMetricBrush}" Text="MEM" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="MemoryLabelText" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="MemoryDetailsText" Margin="0,2,4,0" FontSize="11.5"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="MemoryValueText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                            <ProgressBar x:Name="MemoryProgress" Grid.Row="1" Style="{StaticResource MetricProgressStyle}" />
                        </Grid>
                    </Border>

                    <!-- 3. GPU Card -->
                    <Border x:Name="GpuCard" Height="134" Margin="0,0,0,9" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Margin="0,0,11,0" VerticalAlignment="Center" Background="{DynamicResource GpuMetricSoftBrush}" CornerRadius="17">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource GpuMetricBrush}" Text="GPU" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="GraphicsLabelText" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock x:Name="GpuNameText" Margin="0,2,4,0" FontSize="11.5"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="GpuDetailsText" Margin="0,1,4,0" FontSize="10.5"
                                               Foreground="{DynamicResource AppTertiaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="GpuValueText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                            <local:HistorySparkline x:Name="GpuHistoryChart" Grid.Row="1" Metric="Gpu"
                                                    Stroke="{DynamicResource GpuMetricBrush}"
                                                    Fill="{DynamicResource GpuMetricSoftBrush}"
                                                    GridLine="{DynamicResource AppSeparatorBrush}"
                                                    SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>

                    <!-- 4. Network Card (Telegram circular badges) -->
                    <Grid Height="84" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12,10,12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" Margin="0,0,8,0" Background="{DynamicResource CpuMetricSoftBrush}" CornerRadius="12">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource CpuMetricBrush}" Text="↓" />
                                    </Border>
                                    <TextBlock x:Name="DownloadLabelText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="DownloadValueText" Grid.Row="1" VerticalAlignment="Bottom" FontSize="19"
                                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12,10,12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" Margin="0,0,8,0" Background="{DynamicResource GpuMetricSoftBrush}" CornerRadius="12">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource GpuMetricBrush}" Text="↑" />
                                    </Border>
                                    <TextBlock x:Name="UploadLabelText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="UploadValueText" Grid.Row="1" VerticalAlignment="Bottom" FontSize="19"
                                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 5. Storage Card (Telegram Blue section title) -->
                    <Border x:Name="StorageCard" Style="{StaticResource CardStyle}" Padding="14,11,14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="StorageLabelText" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" />
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock x:Name="NoDrivesText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11.5" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                <UniformGrid x:Name="DriveRowsPanel" Columns="2" HorizontalAlignment="Stretch" Margin="-4,0,-4,0" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>


