<Window x:Class="SysMonitor.UI.GameOverlaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏浮层设置与布局"
        Width="640" Height="720" MinWidth="580" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Style="{DynamicResource AppWindowStyle}">
  <Window.Resources>
    <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CloseBg" Property="Background" Value="#E81123" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CloseBg" Property="Background" Value="#C4101E" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModernSecondaryButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppControlBrush}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppSeparatorBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModernPrimaryButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.76" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="14"
          Background="{DynamicResource AppBackgroundBrush}"
          BorderBrush="{DynamicResource AppSeparatorBrush}"
          BorderThickness="1"
          CornerRadius="16"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.16" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="50" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <Grid Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="MetricsTitleText" Margin="18,0,0,0" VerticalAlignment="Center"
                   FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextBrush}"/>
        <StackPanel Grid.Column="1" Margin="0,0,12,0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="AppearanceButton" Margin="0,0,8,0" Padding="10,4" Height="28"
                  Content="🎨 配色与皮肤..." Style="{StaticResource ModernSecondaryButtonStyle}" Click="AppearanceButton_Click"/>
          <Button x:Name="TitleCloseButton" Style="{StaticResource WindowCloseButtonStyle}" Click="Cancel_Click" ToolTip="关闭">
            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Content Scroll -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalFirst">
        <StackPanel Margin="18,0,18,12">

          <!-- Layout & Alignment Card -->
          <Border Margin="0,0,0,12" Padding="14,12" Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppSeparatorBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock x:Name="LayoutTitleText" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppTextBrush}"/>
              <TextBlock x:Name="LayoutLabelText" FontSize="11.5" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="VerticalLayoutRadio" GroupName="HudLayout" Tag="vertical"
                             IsChecked="True" Checked="LayoutMode_Checked"
                             Margin="0,0,6,0" Padding="8,6" FontWeight="SemiBold">
                  <StackPanel>
                    <TextBlock x:Name="VerticalLayoutTitleText" FontSize="12.5"/>
                    <TextBlock x:Name="VerticalLayoutDescriptionText" Margin="0,2,0,0"
                               FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="HorizontalLayoutRadio" Grid.Column="1" GroupName="HudLayout" Tag="horizontal"
                             Checked="LayoutMode_Checked" Margin="6,0,0,0" Padding="8,6" FontWeight="SemiBold">
                  <StackPanel>
                    <TextBlock x:Name="HorizontalLayoutTitleText" FontSize="12.5"/>
                    <TextBlock x:Name="HorizontalLayoutDescriptionText" Margin="0,2,0,0"
                               FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </RadioButton>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Position Preset Card -->
          <Border Margin="0,0,0,12" Padding="14,12" Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppSeparatorBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock x:Name="PositionTitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
              <TextBlock x:Name="PositionHelpText" Margin="0,4,0,8" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap"/>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionMonitorLabelText" Foreground="{DynamicResource AppSecondaryTextBrush}" FontSize="11.5"/>
                <TextBlock x:Name="PositionMonitorText" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
              </Grid>
              <Grid Margin="0,0,0,4" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionBoundsLabelText" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                <TextBlock x:Name="PositionBoundsText" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}"/>
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionCurrentLabelText" Foreground="{DynamicResource AppSecondaryTextBrush}" FontSize="11.5"/>
                <TextBlock x:Name="PositionCurrentText" Grid.Column="1" Foreground="{DynamicResource AppTextBrush}" FontSize="11.5" FontWeight="SemiBold"/>
              </Grid>
              <TextBlock Text="预设对齐位置" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource AppTextBrush}"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="PositionLeftRadio" GroupName="HudPositionPreset" Tag="0"
                             Checked="PositionPreset_Checked" Margin="0,0,4,0" Padding="4,2" FontWeight="SemiBold"
                             Content="顶部左侧"/>
                <RadioButton x:Name="PositionCenterRadio" Grid.Column="1" GroupName="HudPositionPreset" Tag="50"
                             Checked="PositionPreset_Checked" Margin="2,0,2,0" Padding="4,2" FontWeight="SemiBold"
                             Content="顶部居中"/>
                <RadioButton x:Name="PositionRightRadio" Grid.Column="2" GroupName="HudPositionPreset" Tag="100"
                             Checked="PositionPreset_Checked" Margin="4,0,0,0" Padding="4,2" FontWeight="SemiBold"
                             Content="顶部右侧"/>
              </Grid>
              <CheckBox x:Name="ExactPositionBox" Click="ExactPositionBox_Click" FontWeight="SemiBold" FontSize="12"/>
              <Grid Margin="20,8,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionXLabelText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Slider x:Name="PositionXSlider" Grid.Column="1" Margin="4,0,10,0"
                        SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                        IsMoveToPointEnabled="True" ValueChanged="PositionSlider_ValueChanged"/>
                <TextBox x:Name="PositionXBox" Grid.Column="2" Height="26" VerticalContentAlignment="Center"
                         TextChanged="PositionCoordinateTextChanged"/>
                <TextBlock x:Name="PositionYLabelText" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold"/>
                <Slider x:Name="PositionYSlider" Grid.Row="1" Grid.Column="1" Margin="4,8,10,0"
                        SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                        IsMoveToPointEnabled="True" ValueChanged="PositionSlider_ValueChanged"/>
                <TextBox x:Name="PositionYBox" Grid.Row="1" Grid.Column="2" Height="26" Margin="0,8,0,0"
                         VerticalContentAlignment="Center" TextChanged="PositionCoordinateTextChanged"/>
              </Grid>
              <Button x:Name="ResetPositionButton" Width="88" Height="28" Margin="20,8,0,0"
                      HorizontalAlignment="Left" Style="{StaticResource ModernSecondaryButtonStyle}" Click="ResetPosition_Click"/>
              <TextBlock x:Name="PreviewStatusText" Margin="20,6,0,0" FontSize="11"
                         Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Metrics Matrix Card -->
          <Border Margin="0,0,0,12" Padding="14,12" Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppSeparatorBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="HUD 监控显示项目 (矩阵配置)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource AppTextBrush}"/>
              <Border Background="{DynamicResource AppControlBrush}" CornerRadius="10" BorderBrush="{DynamicResource AppSeparatorBrush}" BorderThickness="1" Padding="4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                  </Grid.RowDefinitions>

                  <!-- Header Row -->
                  <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="6,0,0,0" Margin="1">
                    <TextBlock Text="维度" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" Margin="1">
                    <TextBlock Text="FPS" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextBrush}"/>
                  </Border>
                  <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource AppSurfaceBrush}" Margin="1">
                    <TextBlock Text="CPU" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextBrush}"/>
                  </Border>
                  <Border Grid.Row="0" Grid.Column="3" Background="{DynamicResource AppSurfaceBrush}" Margin="1">
                    <TextBlock Text="GPU" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextBrush}"/>
                  </Border>
                  <Border Grid.Row="0" Grid.Column="4" Background="{DynamicResource AppSurfaceBrush}" Margin="1">
                    <TextBlock Text="内存(RAM)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextBrush}"/>
                  </Border>
                  <Border Grid.Row="0" Grid.Column="5" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0,6,0,0" Margin="1">
                    <TextBlock Text="网络(NET)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextBrush}"/>
                  </Border>

                  <!-- Row 1: 使用率 -->
                  <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" Margin="1">
                    <TextBlock Text="使用率 (%)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="1" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="FpsCheckBox" Content="实时帧率" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="2" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="CpuCheckBox" Content="使用率" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="3" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="GpuCheckBox" Content="使用率" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="4" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="MemoryCheckBox" Content="使用率" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="5" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="NetworkCheckBox" Content="网速(↓↑)" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>

                  <!-- Row 2: 温度 (°C) -->
                  <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" Margin="1">
                    <TextBlock Text="温度 (°C)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="2" Grid.Column="1" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="2" Grid.Column="2" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="CpuTempCheckBox" Content="温度" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="2" Grid.Column="3" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="GpuTempCheckBox" Content="温度" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="2" Grid.Column="4" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="2" Grid.Column="5" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>

                  <!-- Row 3: 功耗 (W) -->
                  <Border Grid.Row="3" Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" Margin="1">
                    <TextBlock Text="功耗 (W)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="3" Grid.Column="1" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="3" Grid.Column="2" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="CpuPowerCheckBox" Content="功耗" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="3" Grid.Column="3" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="GpuPowerCheckBox" Content="功耗" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="3" Grid.Column="4" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="3" Grid.Column="5" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>

                  <!-- Row 4: 频率 (MHz) -->
                  <Border Grid.Row="4" Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" Margin="1">
                    <TextBlock Text="频率 (MHz)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="4" Grid.Column="1" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="4" Grid.Column="2" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="CpuFreqCheckBox" Content="主频" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="4" Grid.Column="3" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <CheckBox x:Name="GpuClockCheckBox" Content="核心频" Margin="0,0,6,0" Click="MetricCheckBox_Click"/>
                      <CheckBox x:Name="GpuMemoryClockCheckBox" Content="显存频" Click="MetricCheckBox_Click"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="4" Grid.Column="4" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="MemoryFreqCheckBox" Content="内存频率" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="4" Grid.Column="5" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>

                  <!-- Row 5: 显存 / 容量 -->
                  <Border Grid.Row="5" Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0,0,0,6" Margin="1">
                    <TextBlock Text="显存 / 容量" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="5" Grid.Column="1" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="5" Grid.Column="2" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="5" Grid.Column="3" Margin="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                    <CheckBox x:Name="GpuMemoryCheckBox" Content="显存占用" HorizontalAlignment="Center" VerticalAlignment="Center" Click="MetricCheckBox_Click"/>
                  </Border>
                  <Border Grid.Row="5" Grid.Column="4" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="4">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                  <Border Grid.Row="5" Grid.Column="5" Margin="1" Background="{DynamicResource AppSurfaceBrush}" Opacity="0.3" CornerRadius="0,0,6,0">
                    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                  </Border>
                </Grid>
              </Border>

              <!-- Universal Row & Sub-Item Reorder Section -->
              <Border Margin="0,10,0,0" Padding="12,10" Background="{DynamicResource AppControlBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppSeparatorBrush}" BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                  </Grid.ColumnDefinitions>

                  <!-- Group Selector -->
                  <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="排序对象：" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="OrderTargetBox" Width="260" Height="28" SelectionChanged="OrderTargetBox_SelectionChanged">
                      <ComboBoxItem Content="纵向：显示行排序 (CPU / GPU / RAM...)" Tag="row" IsSelected="True"/>
                      <ComboBoxItem Content="横向：CPU 内部各指标显示顺序" Tag="cpu"/>
                      <ComboBoxItem Content="横向：GPU 内部各指标显示顺序" Tag="gpu"/>
                      <ComboBoxItem Content="横向：内存 (RAM) 内部指标顺序" Tag="memory"/>
                      <ComboBoxItem Content="横向：网络 (NET) 内部指标顺序" Tag="network"/>
                    </ComboBox>
                  </StackPanel>

                  <!-- Reorder ListBox -->
                  <ListBox x:Name="MetricList" Grid.Row="1" Grid.Column="0" Height="110" BorderBrush="{DynamicResource AppSeparatorBrush}" Background="{DynamicResource AppSurfaceBrush}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" Padding="8,3" FontSize="12" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <!-- Up / Down Buttons -->
                  <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="MoveUpButton" Height="32" Margin="0,0,0,8" Style="{StaticResource ModernSecondaryButtonStyle}" Click="MoveUp_Click"/>
                    <Button x:Name="MoveDownButton" Height="32" Style="{StaticResource ModernSecondaryButtonStyle}" Click="MoveDown_Click"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- Advanced / Legacy Expander Card -->
          <Expander x:Name="AdvancedExpander" Margin="0,0,0,12" IsExpanded="False"
                    Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppSeparatorBrush}"
                    BorderThickness="1">
            <Expander.Header>
              <TextBlock x:Name="AdvancedTitleText" FontSize="13.5" FontWeight="SemiBold" Margin="4,0"/>
            </Expander.Header>
            <StackPanel Margin="14,6,14,14">
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SamplingLabelText" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" FontSize="12"/>
                <ComboBox x:Name="SamplingBox" Grid.Column="1" Height="32" SelectedValuePath="Tag"/>
              </Grid>
              <Separator Margin="0,0,0,12"/>
              <TextBlock x:Name="LegacyTitleText" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
              <TextBlock x:Name="LegacyTargetLabelText" Margin="0,8,0,4" FontSize="11.5" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
              <ComboBox x:Name="LegacyTargetBox" Height="32" DisplayMemberPath="DisplayName"
                        SelectionChanged="LegacyTargetBox_SelectionChanged"/>
              <CheckBox x:Name="LegacyCompatibilityBox" Margin="0,10,0,0" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock x:Name="LegacyStatusText" Margin="20,4,0,0" FontSize="11.5" Foreground="{DynamicResource AppAccentBrush}" TextWrapping="Wrap"/>
              <TextBlock x:Name="LegacyWarningText" Margin="20,4,0,0" FontSize="11" Foreground="{DynamicResource WarningMetricBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <!-- Bottom Actions -->
      <Grid Grid.Row="2" Margin="18,0,18,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="CancelButton" Width="80" Margin="0,0,10,0" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Cancel_Click"/>
          <Button x:Name="ApplyButton" Width="80" Style="{StaticResource ModernPrimaryButtonStyle}" Click="Apply_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
