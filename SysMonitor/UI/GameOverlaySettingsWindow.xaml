<Window x:Class="SysMonitor.UI.GameOverlaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="720" MinWidth="520" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#FFF6F6F8">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="MetricsTitleText" FontSize="18" FontWeight="SemiBold" Foreground="#FF1D1D1F"/>

    <ScrollViewer Grid.Row="1" Margin="0,14,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Margin="0,0,0,14" Padding="16" CornerRadius="14"
                Background="#FFFFFFFF" BorderBrush="#18000000" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="LayoutTitleText" FontSize="15" FontWeight="SemiBold" Foreground="#FF1D1D1F"/>
            <TextBlock x:Name="LayoutLabelText" Margin="0,10,0,5" FontSize="12" Foreground="#FF6E6E73" TextWrapping="Wrap"/>
            <ComboBox x:Name="LayoutModeBox" Height="36" SelectedValuePath="Tag"/>
          </StackPanel>
        </Border>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
          <ListBox x:Name="MetricList" MinHeight="210" BorderBrush="#18000000" Background="White">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}" Padding="10,7"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <Button x:Name="MoveUpButton" Height="36" Margin="0,0,0,8" Click="MoveUp_Click"/>
            <Button x:Name="MoveDownButton" Height="36" Click="MoveDown_Click"/>
            <TextBlock x:Name="OrderHelpText" Margin="0,16,0,0" Foreground="#FF6E6E73" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="SamplingLabelText" VerticalAlignment="Center" Foreground="#FF3A3A3C"/>
          <ComboBox x:Name="SamplingBox" Grid.Column="1" Height="36" SelectedValuePath="Tag"/>
        </Grid>

        <Border Margin="0,0,0,16" Padding="16" CornerRadius="14"
                Background="#FFFFFFFF" BorderBrush="#18000000" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="PositionTitleText" FontSize="15" FontWeight="SemiBold" Foreground="#FF1D1D1F"/>
            <TextBlock x:Name="PositionHelpText" Margin="0,6,0,12" FontSize="11" Foreground="#FF6E6E73" TextWrapping="Wrap"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PositionMonitorLabelText" Foreground="#FF6E6E73"/>
              <TextBlock x:Name="PositionMonitorText" Grid.Column="1" Foreground="#FF3A3A3C" TextWrapping="Wrap"/>
            </Grid>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PositionBoundsLabelText" Foreground="#FF6E6E73"/>
              <TextBlock x:Name="PositionBoundsText" Grid.Column="1" Foreground="#FF3A3A3C"/>
            </Grid>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PositionCurrentLabelText" Foreground="#FF6E6E73"/>
              <TextBlock x:Name="PositionCurrentText" Grid.Column="1" Foreground="#FF3A3A3C"/>
            </Grid>
            <CheckBox x:Name="ExactPositionBox" Click="ExactPositionBox_Click" FontWeight="SemiBold"/>
            <Grid Margin="24,10,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PositionXLabelText" VerticalAlignment="Center"/>
              <Slider x:Name="PositionXSlider" Grid.Column="1" Margin="4,0,12,0"
                      SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                      IsMoveToPointEnabled="True"
                      ValueChanged="PositionSlider_ValueChanged"/>
              <TextBox x:Name="PositionXBox" Grid.Column="2" Height="32" VerticalContentAlignment="Center"
                       TextChanged="PositionCoordinateTextChanged"/>
              <TextBlock x:Name="PositionYLabelText" Grid.Row="1" VerticalAlignment="Center" Margin="0,9,0,0"/>
              <Slider x:Name="PositionYSlider" Grid.Row="1" Grid.Column="1" Margin="4,9,12,0"
                      SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                      IsMoveToPointEnabled="True"
                      ValueChanged="PositionSlider_ValueChanged"/>
              <TextBox x:Name="PositionYBox" Grid.Row="1" Grid.Column="2" Height="32" Margin="0,9,0,0"
                       VerticalContentAlignment="Center" TextChanged="PositionCoordinateTextChanged"/>
            </Grid>
            <Button x:Name="ResetPositionButton" Width="88" Height="32" Margin="24,10,0,0"
                    HorizontalAlignment="Left" Click="ResetPosition_Click"/>
          </StackPanel>
        </Border>

        <Border Margin="0,0,0,18" Padding="16" CornerRadius="14"
                Background="#FFFFFFFF" BorderBrush="#18000000" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="LegacyTitleText" FontSize="15" FontWeight="SemiBold" Foreground="#FF1D1D1F"/>
            <TextBlock x:Name="LegacyTargetLabelText" Margin="0,10,0,5" FontSize="12" Foreground="#FF6E6E73"/>
            <ComboBox x:Name="LegacyTargetBox" Height="36" DisplayMemberPath="DisplayName"
                      SelectionChanged="LegacyTargetBox_SelectionChanged"/>
            <CheckBox x:Name="LegacyCompatibilityBox" Margin="0,12,0,0" FontWeight="SemiBold"/>
            <TextBlock x:Name="LegacyStatusText" Margin="24,6,0,0" FontSize="12" Foreground="#FF007AFF" TextWrapping="Wrap"/>
            <TextBlock x:Name="LegacyWarningText" Margin="24,6,0,0" FontSize="11" Foreground="#FF9A6700" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ApplyButton" Width="96" Height="36" Margin="0,0,10,0" Click="Apply_Click"/>
      <Button x:Name="CancelButton" Width="96" Height="36" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
