<Window x:Class="SysMonitor.UI.BandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysMonitor"
        Width="450"
        Height="34"
        MinHeight="34"
        MaxHeight="34"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BandTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BandTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="MetricGroup" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Width" Value="62" />
            <Setter Property="Margin" Value="5.5,0" />
        </Style>
        <Style x:Key="MetricSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="{DynamicResource BandSeparatorBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="BandHitTarget"
          Background="#01000000">
        <Border x:Name="BandRoot"
                Background="{DynamicResource BandBackgroundBrush}"
                CornerRadius="{DynamicResource BandCornerRadius}"
                BorderThickness="0">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform Y="-1.5" />
            </StackPanel.RenderTransform>
            <Grid x:Name="CpuGroup" Style="{StaticResource MetricGroup}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource MetricLabel}" Text="CPU" />
                    <TextBlock x:Name="CpuTemperatureText"
                               Margin="4,0,0,0"
                               Style="{StaticResource MetricLabel}"
                               Text="--°" />
                </StackPanel>
                <TextBlock x:Name="CpuValueText"
                           Grid.Row="1"
                           Style="{StaticResource MetricValue}"
                           Text="0%" />
            </Grid>

            <Border x:Name="CpuMemorySeparator" Style="{StaticResource MetricSeparator}" />

            <Grid x:Name="MemoryGroup" Style="{StaticResource MetricGroup}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource MetricLabel}" Text="MEM" />
                <TextBlock x:Name="MemoryValueText"
                           Grid.Row="1"
                           Style="{StaticResource MetricValue}"
                           Text="0%" />
            </Grid>

            <Border x:Name="MemoryGpuSeparator" Style="{StaticResource MetricSeparator}" />

            <Grid x:Name="GpuGroup" Style="{StaticResource MetricGroup}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource MetricLabel}" Text="GPU" />
                    <TextBlock x:Name="GpuTemperatureText"
                               Margin="4,0,0,0"
                               Style="{StaticResource MetricLabel}"
                               Text="--℃" />
                </StackPanel>
                <TextBlock x:Name="GpuValueText"
                           Grid.Row="1"
                           Style="{StaticResource MetricValue}"
                           Text="0%" />
            </Grid>

            <Border x:Name="GpuDownloadSeparator" Style="{StaticResource MetricSeparator}" />

            <Grid x:Name="DownloadGroup" Style="{StaticResource MetricGroup}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource MetricLabel}" Text="DOWN" />
                <TextBlock x:Name="DownloadValueText"
                           Grid.Row="1"
                           Style="{StaticResource MetricValue}"
                           Text="0 B/s" />
            </Grid>

            <Border x:Name="DownloadUploadSeparator" Style="{StaticResource MetricSeparator}" />

            <Grid x:Name="UploadGroup" Style="{StaticResource MetricGroup}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource MetricLabel}" Text="UP" />
                <TextBlock x:Name="UploadValueText"
                           Grid.Row="1"
                           Style="{StaticResource MetricValue}"
                           Text="0 B/s" />
            </Grid>

            <Border x:Name="UploadDiskSeparator" Style="{StaticResource MetricSeparator}" />

            <Grid x:Name="DiskGroup" Style="{StaticResource MetricGroup}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="DiskLabelText"
                           Grid.Row="0"
                           Style="{StaticResource MetricLabel}"
                           Text="DISK" />
                <TextBlock x:Name="DiskValueText"
                           Grid.Row="1"
                           Style="{StaticResource MetricValue}"
                           Text="0%" />
            </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
