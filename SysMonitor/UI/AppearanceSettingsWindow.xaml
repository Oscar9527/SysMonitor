<Window x:Class="SysMonitor.UI.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务栏外观"
        Width="420"
        Height="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="#1D1D1F">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5EA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6E6E73" />

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="#FFE5E3" />
                                <Setter Property="Foreground" Value="#FF3B30" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="#FFD8D5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="#F0F0F3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="#E7E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#007AFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="#0873E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="#0068D9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="WindowTitleText"
                           Margin="22,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="任务栏外观" />
            </Grid>

            <Button Grid.Column="1"
                    Margin="0,0,14,0"
                    Style="{StaticResource CloseButtonStyle}"
                    ToolTip="关闭"
                    Click="CloseButton_Click">
                <Path Width="11"
                      Height="11"
                      Data="M 1,1 L 10,10 M 10,1 L 1,10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stretch="Fill" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="20,0,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="218" />
                <RowDefinition Height="12" />
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="16,10"
                    Background="White"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="字体" />
                    <ComboBox x:Name="FontFamilyComboBox"
                              Grid.Column="1"
                              Height="32"
                              Padding="8,3"
                              VerticalContentAlignment="Center"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              SelectionChanged="FontFamilyComboBox_SelectionChanged" />

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="字号" />
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FontSizeSlider"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Minimum="9"
                                Maximum="20"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                SmallChange="1"
                                LargeChange="1"
                                ValueChanged="FontSizeSlider_ValueChanged" />
                        <Border Grid.Column="1"
                                Height="30"
                                VerticalAlignment="Center"
                                Background="#F0F0F3"
                                CornerRadius="8">
                            <TextBlock x:Name="FontSizeValueText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="项目间距" />
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ItemSpacingSlider"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="18"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                SmallChange="1"
                                LargeChange="2"
                                ValueChanged="ItemSpacingSlider_ValueChanged" />
                        <Border Grid.Column="1"
                                Height="30"
                                VerticalAlignment="Center"
                                Background="#F0F0F3"
                                CornerRadius="8">
                            <TextBlock x:Name="ItemSpacingValueText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="3"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="左右位置" />
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="HorizontalOffsetSlider"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                SmallChange="1"
                                LargeChange="1"
                                ValueChanged="HorizontalOffsetSlider_ValueChanged" />
                        <Border Grid.Column="1"
                                Height="30"
                                VerticalAlignment="Center"
                                Background="#F0F0F3"
                                CornerRadius="8">
                            <TextBlock x:Name="HorizontalOffsetValueText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="0% 最左，100% 最右；减小间距可扩大安全移动范围" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Padding="16,0"
                    Background="White"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="预览" />
                    <TextBlock x:Name="PreviewText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="CPU 37%  MEM 63%  ↓ 1.2 MB/s" />
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#34A853" />
                <Button Grid.Column="1"
                        MinWidth="66"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="应用"
                        Click="ApplyButton_Click" />
                <Button Grid.Column="3"
                        MinWidth="88"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="恢复默认"
                        Click="RestoreDefaultsButton_Click" />
                <Button Grid.Column="5"
                        MinWidth="66"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="关闭"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
