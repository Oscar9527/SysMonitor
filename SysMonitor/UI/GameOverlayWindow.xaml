<Window x:Class="SysMonitor.UI.GameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysMonitor"
        Width="304" Height="176"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False">
    <Border Margin="8"
            Padding="16,13"
            CornerRadius="18"
            Background="#E621242A"
            BorderBrush="#5CFFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.38" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="9" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="9" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#FF32D6A6" Margin="0,0,8,0" />
                        <TextBlock x:Name="PresentFpsLabel" Foreground="#BFFFFFFF" FontSize="11" />
                    </StackPanel>
                    <TextBlock x:Name="FrameStateText" Foreground="#76FFFFFF" FontSize="9"
                               Margin="15,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock x:Name="PresentFpsValue" Text="--" Foreground="White"
                               FontFamily="Segoe UI Variable Display Semibold" FontSize="28" />
                    <TextBlock Text=" FPS" Foreground="#BFFFFFFF" FontSize="11" Margin="3,0,0,3" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CpuLabel" Foreground="#8FFFFFFF" FontSize="10" />
                    <TextBlock x:Name="CpuValue" Text="--" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="MemoryLabel" Foreground="#8FFFFFFF" FontSize="10" />
                    <TextBlock x:Name="MemoryValue" Text="--" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="GpuLabel" Foreground="#8FFFFFFF" FontSize="10" />
                    <TextBlock x:Name="GpuValue" Text="--" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CpuTemperatureLabel" Foreground="#8FFFFFFF" FontSize="10" />
                    <TextBlock x:Name="CpuTemperatureValue" Text="--" Foreground="#E6FFFFFF" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="GpuTemperatureLabel" Foreground="#8FFFFFFF" FontSize="10" />
                    <TextBlock x:Name="GpuTemperatureValue" Text="--" Foreground="#E6FFFFFF" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="FrequencyLabel" Foreground="#8FFFFFFF" FontSize="10" />
                    <TextBlock x:Name="FrequencyValue" Text="--" Foreground="#E6FFFFFF" FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
