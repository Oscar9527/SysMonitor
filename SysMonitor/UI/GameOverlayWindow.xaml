<Window x:Class="SysMonitor.UI.GameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysMonitor" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowActivated="False" ShowInTaskbar="False"
        Focusable="False" IsHitTestVisible="False">
    <Border Margin="6,4" Padding="0" Background="Transparent">
        <Grid x:Name="OverlayGrid" MinWidth="250">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Margin" Value="0,0,8,1"/>
                    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                    <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.95" Color="Black"/></Setter.Value></Setter>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="GpuLabel" Grid.Row="0" Grid.Column="0" Text="GPU" Foreground="#66D9FF"/>
            <TextBlock x:Name="GpuValue" Grid.Row="0" Grid.Column="1" Foreground="White"/>
            <TextBlock x:Name="CpuLabel" Grid.Row="1" Grid.Column="0" Text="CPU" Foreground="#8BE9FD"/>
            <TextBlock x:Name="CpuValue" Grid.Row="1" Grid.Column="1" Foreground="White"/>
            <TextBlock x:Name="FpsLabel" Grid.Row="2" Grid.Column="0" Text="FPS" Foreground="#50FA7B"/>
            <TextBlock x:Name="FpsValue" Grid.Row="2" Grid.Column="1" Foreground="White"/>
            <TextBlock x:Name="MemoryLabel" Grid.Row="3" Grid.Column="0" Text="RAM" Foreground="#F1FA8C"/>
            <TextBlock x:Name="MemoryValue" Grid.Row="3" Grid.Column="1" Foreground="White"/>
            <TextBlock x:Name="NetworkLabel" Grid.Row="4" Grid.Column="0" Text="NET" Foreground="#FFB86C"/>
            <TextBlock x:Name="NetworkValue" Grid.Row="4" Grid.Column="1" Foreground="White"/>
            
        </Grid>
    </Border>
</Window>

